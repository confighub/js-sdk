{
  "name": "confighub-js-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "ConfigHub JavaScript SDK \u2014 browser auth and typed API client",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run build -w @confighub/api -w @confighub/rtk-query -w @confighub/react-auth",
    "typecheck": "npm run typecheck -w @confighub/api -w @confighub/rtk-query -w @confighub/react-auth",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@rtk-query/codegen-openapi": "^2.0.0",
    "openapi-typescript": "^7.4.4",
    "tsup": "^8.3.5",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
