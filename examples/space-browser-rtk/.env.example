# The ConfigHub instance this app talks to.
VITE_CONFIGHUB_BASE_URL=https://hub.confighub.com

# This app's registered OAuth client id. Note the port is 5174 for this example
# (the plain space-browser uses 5173), so register with:
#   cub oauthclient create space-browser-rtk --redirect-uri http://localhost:5174/
VITE_OAUTH_CLIENT_ID=
