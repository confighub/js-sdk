{
  "name": "@confighub/api",
  "version": "0.1.0",
  "description": "Typed, framework-agnostic client for the ConfigHub API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/confighub/js-sdk.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/confighub/js-sdk/tree/main/packages/api#readme",
  "bugs": "https://github.com/confighub/js-sdk/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.1"
  },
  "keywords": [
    "confighub",
    "openapi",
    "api-client",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
